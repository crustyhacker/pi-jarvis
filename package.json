{
  "name": "pi-jarvis",
  "version": "1.4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "A /jarvis side-conversation overlay extension for Pi.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crustyhacker/pi-jarvis.git"
  },
  "homepage": "https://github.com/crustyhacker/pi-jarvis#readme",
  "bugs": {
    "url": "https://github.com/crustyhacker/pi-jarvis/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "extension",
    "tui",
    "overlay",
    "assistant"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "npm run check && node --import tsx --test test/jarvis.test.ts test/config-regression.test.ts test/index-regression.test.ts test/main-context-regression.test.ts test/overlay-regression.test.ts test/side-runtime.test.ts",
    "verify:release": "node --import tsx test/release-verification.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
